# Copy this to .env and fill in real values. Never commit .env.

# Adds the project root to Python's module search path so
# `from state import ...` works from any subdirectory.
PYTHONPATH=.

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-weekly-intel

# Anthropic API
ANTHROPIC_API_KEY=

# NVIDIA NIM (build.nvidia.com) -- embeddings only (discovery/embeddings.py,
# nvidia/nemotron-3-embed-1b). Real key format starts with "nvapi-".
NVIDIA_API_KEY=

# Bookmarks source file for ingest_bookmarks.
# Default (unset): data/tweets.json — full 510-item set, real API cost.
# Set to data/test_fixture.json for cheap iteration on graph wiring (8 real items).
TWILLOT_JSON_PATH=data/test_fixture.json

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AgentMail (shared inbox for Substack/newsletter sources GitHub Actions runners
# can't reach directly via RSS -- see discovery/config/blog_sources.yaml's header
# comment). The real sender-address mapping lives in
# discovery/config/agentmail_sources.yaml (gitignored, personal subscription
# data) -- copy discovery/config/agentmail_sources.yaml.example to get started.
AGENTMAIL_API_KEY=

# Trello (Phase 4+)
TRELLO_API_KEY=
TRELLO_TOKEN=
# Board ID for the real project-tracking board (saturday/trello_client.py
# reads this at call time, same lazy-read pattern as DB_URI below -- no
# hardcoded default, no placeholder fallback).
TRELLO_BOARD_ID=

# Supabase PostgreSQL connection string for LangGraph checkpointer (Phase 4+)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Find this in Supabase dashboard → Project Settings → Database → Connection string → URI
DB_URI=
